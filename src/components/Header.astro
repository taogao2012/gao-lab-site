---
import { site } from '../config';
import SocialLinks from './SocialLinks.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return pathname === '/';
  return pathname === h || pathname.startsWith(h + '/');
}
---

<header class="border-b border-rule bg-white/95 backdrop-blur sticky top-0 z-40">
  <div class="container-page flex items-center justify-between gap-6 py-4">
    <a href="/" class="no-underline group flex flex-col shrink-0 leading-tight">
      <span class="font-serif text-xl font-semibold text-ink group-hover:text-accent transition-colors">
        {site.name}
      </span>
      <span class="hidden sm:inline text-[11px] text-ink-muted tracking-wide mt-0.5">North Carolina State University</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {site.nav.map((item) => {
          const hasChildren = 'children' in item && item.children && item.children.length > 0;
          if (hasChildren) {
            return (
              <li class="relative group/menu">
                <a
                  href={item.href}
                  class:list={['nav-link no-underline inline-flex items-center gap-1', { 'nav-link-active': isActive(item.href) }]}
                  aria-haspopup="true"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M1 3.5 5 7l4-3.5"/></svg>
                </a>
                <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:visible transition-all duration-150">
                  <ul class="min-w-[220px] bg-white border border-rule shadow-sm py-2">
                    {item.children!.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={['block whitespace-nowrap px-4 py-2 text-sm no-underline text-ink-soft hover:bg-paper hover:text-accent transition-colors', { 'text-ink font-medium': isActive(child.href) }]}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          }
          return (
            <li>
              <a
                href={item.href}
                class:list={['nav-link no-underline', { 'nav-link-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
        <li>
          <a
            href={site.intranet.url}
            target="_blank"
            rel="noopener"
            class="nav-link no-underline inline-flex items-center gap-1"
            title={site.intranet.note}
          >
            {site.intranet.label}
            <span aria-hidden="true" class="text-ink-muted">↗</span>
          </a>
        </li>
      </ul>
    </nav>

    <button
      id="mobile-menu-toggle"
      class="lg:hidden text-ink-soft p-1"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-rule bg-white">
    <nav aria-label="Mobile" class="container-page py-4">
      <ul class="flex flex-col gap-3">
        {site.nav.map((item) => {
          const hasChildren = 'children' in item && item.children && item.children.length > 0;
          return (
            <li>
              <a href={item.href} class:list={['nav-link no-underline block py-1', { 'nav-link-active': isActive(item.href) }]}>
                {item.label}
              </a>
              {hasChildren && (
                <ul class="pl-4 mt-1 border-l border-rule space-y-1">
                  {item.children!.map((child) => (
                    <li><a href={child.href} class="nav-link no-underline block py-1 text-sm">{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
        <li>
          <a href={site.intranet.url} target="_blank" rel="noopener" class="nav-link no-underline block py-1">
            {site.intranet.label} ↗
          </a>
        </li>
        <li class="pt-2"><SocialLinks size={18} /></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>
