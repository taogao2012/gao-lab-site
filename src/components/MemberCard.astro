---
import { photoFor } from '../data/member-photos';

interface Props {
  name: string;
  role?: string;
  level?: string;
  period?: string;
  expected?: string;
  graduated?: string;
  now?: string;
  from?: string;
  size?: 'sm' | 'md';
}

const {
  name,
  role,
  level,
  period,
  expected,
  graduated,
  now,
  from,
  size = 'md',
} = Astro.props;

const photo = photoFor(name);

// No cartoon avatar: members without a real photo get a plain framed
// monogram (initials) instead — never a generated face.
const cleaned = name.replace(/\([^)]*\)/g, ' ').trim();
const parts = cleaned.split(/\s+/).filter(Boolean);
const initials = parts.length
  ? (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase()
  : '';

const photoClasses = size === 'sm'
  ? 'aspect-square w-20 rounded-full'
  : 'aspect-square w-full';
---

<article class={`flex ${size === 'sm' ? 'gap-4 items-start' : 'flex-col gap-3'}`}>
  {photo ? (
    <img
      src={photo}
      alt={name}
      loading="lazy"
      decoding="async"
      class={`${photoClasses} object-cover bg-paper border border-rule`}
    />
  ) : (
    <div
      class={`${photoClasses} flex items-center justify-center bg-paper border border-rule text-ink-muted font-serif select-none ${size === 'sm' ? 'text-lg' : 'text-4xl'}`}
      aria-label={name}
    >
      {initials}
    </div>
  )}
  <div class="min-w-0 flex-1">
    <p class="font-serif text-base text-ink leading-tight">{name}</p>
    {role && <p class="text-xs text-ink-muted mt-1">{role}</p>}
    {level && <p class="text-xs text-ink-muted mt-1">{level}</p>}
    {from && <p class="text-xs text-ink-muted mt-1">{from}</p>}
    {period && <p class="text-xs text-ink-muted mt-1">{period}</p>}
    {expected && <p class="text-xs text-ink-muted">Expected {expected}</p>}
    {graduated && <p class="text-xs text-ink-muted">Graduated {graduated}</p>}
    {now && <p class="text-xs text-ink-muted italic mt-1">Now: {now}</p>}
  </div>
</article>
