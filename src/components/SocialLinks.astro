---
import Icon from './Icon.astro';
import { site } from '../config';

interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: cls = '' } = Astro.props;

const externalLinks = [
  { href: site.social.scholar, name: 'scholar' as const, label: 'Google Scholar' },
  { href: site.social.orcid, name: 'orcid' as const, label: 'ORCID' },
  { href: site.social.linkedin, name: 'linkedin' as const, label: 'LinkedIn' },
  { href: site.social.twitter, name: 'x' as const, label: 'X (Twitter)' },
];
---

<ul class={`flex items-center gap-3 ${cls}`}>
  {externalLinks.map((link) => (
    <li>
      <a
        href={link.href}
        rel="me noopener"
        target="_blank"
        aria-label={link.label}
        title={link.label}
        class="text-ink-muted hover:text-accent transition-colors no-underline inline-flex"
      >
        <Icon name={link.name} size={size} />
      </a>
    </li>
  ))}
</ul>
