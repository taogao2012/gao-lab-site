---
interface Pub {
  id: string;
  doi: string | null;
  title: string;
  year: number | null;
  date: string | null;
  venue: string | null;
  volume: string | null;
  issue: string | null;
  firstPage: string | null;
  lastPage: string | null;
  oaUrl: string | null;
  citations: number;
  authors: Array<{ name: string; isPI: boolean }>;
  selected?: boolean;
  isCorresponding?: boolean;
  isCoFirst?: boolean;
}

interface Props {
  items: Pub[];
  numbered?: boolean;
}

const { items, numbered = true } = Astro.props;

// PI authorship-role markers (CV convention: * corresponding, † co-first / equal contribution).
const roleMark = (p: Pub) => `${p.isCorresponding ? '*' : ''}${p.isCoFirst ? '†' : ''}`;
const roleTitle = (p: Pub) =>
  [p.isCorresponding ? 'Corresponding author' : null, p.isCoFirst ? 'Co-first author (equal contribution)' : null]
    .filter(Boolean)
    .join(' · ');
const anyCorresponding = items.some((p) => p.isCorresponding);
const anyCoFirst = items.some((p) => p.isCoFirst);
---

{(anyCorresponding || anyCoFirst) && (
  <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-muted">
    {anyCorresponding && <span><sup class="text-accent font-semibold">*</sup> Corresponding author</span>}
    {anyCoFirst && <span><sup class="text-accent font-semibold">†</sup> Co-first author (equal contribution)</span>}
  </p>
)}

<ol class="mt-6 divide-y divide-rule">
  {items.map((p, i) => (
    <li class="py-5 flex gap-6">
      {numbered && (
        <span class="font-mono text-xs text-ink-muted pt-1 w-10 shrink-0">{String(items.length - i).padStart(2, '0')}</span>
      )}
      <div class="flex-1 min-w-0">
        <h3 class="font-serif text-lg leading-snug text-ink">
          <a href={p.doi ? `https://doi.org/${p.doi}` : p.id} target="_blank" rel="noopener" class="no-underline hover:text-accent">
            {p.title}
          </a>
        </h3>
        <p class="mt-1.5 text-sm text-ink-soft">
          {p.authors.map((a, idx) => (
            <span class={a.isPI ? 'font-semibold text-ink' : ''}>
              {a.name}{a.isPI && (p.isCorresponding || p.isCoFirst) && (
                <sup class="text-accent font-semibold" title={roleTitle(p)}>{roleMark(p)}</sup>
              )}{idx < p.authors.length - 1 ? ', ' : ''}
            </span>
          ))}
        </p>
        <p class="mt-1.5 text-sm text-ink-muted">
          <span class="italic">{p.venue ?? '—'}</span>
          {p.volume && <span> · {p.volume}{p.issue ? `(${p.issue})` : ''}</span>}
          {p.firstPage && <span>, {p.firstPage}{p.lastPage ? `–${p.lastPage}` : ''}</span>}
          <span> · {p.year}</span>
        </p>
        <p class="mt-2 flex flex-wrap gap-3 text-xs">
          {p.doi && (
            <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener" class="text-accent no-underline hover:underline">DOI</a>
          )}
          <a
            href={p.oaUrl ?? `https://scholar.google.com/scholar?q=${encodeURIComponent(p.doi ?? p.title)}`}
            target="_blank"
            rel="noopener"
            class="text-accent no-underline hover:underline"
            title={p.oaUrl ? 'Open-access PDF' : 'Search Scholar for a PDF copy'}
          >PDF</a>
          <span class="text-ink-muted">{p.citations} citations</span>
          {p.selected && <span class="text-accent font-medium">★ Selected</span>}
        </p>
      </div>
    </li>
  ))}
</ol>
