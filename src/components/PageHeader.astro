---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="container-page pt-12 md:pt-16 pb-8 md:pb-12 border-b border-rule">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h1 class="max-w-4xl">{title}</h1>
  {description && <p class="mt-4 max-w-3xl text-lg text-ink-soft">{description}</p>}
</header>
