---
// NC State institutional brand bar — sits above the site header on every page,
// mirroring the dark-gray strip used across ncsu.edu sites.
---

<div class="bg-[#1a1a1a] text-white text-[11px] tracking-wide">
  <div class="container-page py-2 flex flex-wrap items-center gap-x-3 gap-y-1">
    <a
      href="https://www.ncsu.edu"
      target="_blank"
      rel="noopener"
      class="font-semibold tracking-wider no-underline text-white hover:text-white/80"
    >
      NC STATE UNIVERSITY
    </a>
    <span class="text-white/30" aria-hidden="true">·</span>
    <a
      href="https://www.engr.ncsu.edu"
      target="_blank"
      rel="noopener"
      class="no-underline text-white/85 hover:text-white"
    >
      College of Engineering
    </a>
    <span class="text-white/30" aria-hidden="true">·</span>
    <a
      href="https://cbe.ncsu.edu"
      target="_blank"
      rel="noopener"
      class="no-underline text-white/85 hover:text-white"
    >
      Department of Chemical and Biomolecular Engineering
    </a>
  </div>
</div>
