---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { galleryItems, categoryLabels } from '../data/gallery';
import type { GalleryItem } from '../data/gallery';

// Highlights now live on /news/ as "News and Highlights". The gallery shows
// only the photographic categories below.
const order: GalleryItem['category'][] = ['group', 'pioneers', 'event', 'equipment'];

// Sort each category's items in reverse chronological order. Items without
// a `date` field fall to the bottom of their section.
function sortDesc(items: GalleryItem[]) {
  return [...items].sort((a, b) => {
    if (a.date && b.date) return b.date.localeCompare(a.date);
    if (a.date) return -1;
    if (b.date) return 1;
    return 0;
  });
}

const grouped = order
  .map((cat) => ({ cat, items: sortDesc(galleryItems.filter((i) => i.category === cat)) }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Gallery"
  description="Photos from the SuPER Lab — group events, lab tours, members, and campus life."
>
  <section class="container-page py-10">
    <nav aria-label="Categories" class="flex flex-wrap gap-2 mb-12">
      {grouped.map(({ cat, items }) => (
        <a href={`#cat-${cat}`} class="text-xs px-3 py-1.5 border border-rule no-underline text-ink-soft hover:border-accent hover:text-accent transition-colors">
          {categoryLabels[cat]} <span class="text-ink-muted">({items.length})</span>
        </a>
      ))}
    </nav>

    {grouped.map(({ cat, items }) => (
      <section id={`cat-${cat}`} class="scroll-mt-24 mb-16">
        <h2 class="font-serif text-2xl border-b border-rule pb-3 mb-6">{categoryLabels[cat]}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {items.map((item) => (
            <figure class="group">
              {item.youtubeId ? (
                <div class="relative aspect-[4/3] bg-paper border border-rule overflow-hidden">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${item.youtubeId}?rel=0`}
                    title={item.alt}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                    class="absolute inset-0 w-full h-full"
                  />
                </div>
              ) : (
                <a href={item.src} target="_blank" rel="noopener" class="block overflow-hidden bg-paper border border-rule no-underline">
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    style={item.zoom ? `--gallery-zoom: ${item.zoom}` : undefined}
                    class={`w-full aspect-[4/3] transition-transform duration-300 gallery-zoom ${item.fit === 'contain' ? 'object-contain' : 'object-cover'} ${item.position === 'top' ? 'object-top' : item.position === 'bottom' ? 'object-bottom' : 'object-center'}`}
                  />
                </a>
              )}
              {(item.caption || item.date) && (
                <figcaption class="mt-2 flex items-baseline gap-3 text-xs text-ink-muted">
                  {item.caption && <span class="text-ink-soft">{item.caption}</span>}
                  {item.date && <span class="ml-auto font-mono">{item.date}</span>}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  /* Base zoom (per-photo via --gallery-zoom) plus the subtle hover lift. */
  .gallery-zoom { transform: scale(var(--gallery-zoom, 1)); transform-origin: center; }
  .group:hover .gallery-zoom { transform: scale(calc(var(--gallery-zoom, 1) * 1.02)); }
</style>
