---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PublicationList from '../../components/PublicationList.astro';
import publications from '../../data/publications.json';

const all = publications.items;
const items = all
  .filter((p: any) => p.kind === 'conference')
  .sort((a: any, b: any) => (b.date ?? '').localeCompare(a.date ?? ''));

const counts = {
  papers: all.filter((p: any) => p.kind === 'journal').length,
  preprints: all.filter((p: any) => p.kind === 'preprint').length,
  conferences: all.filter((p: any) => p.kind === 'conference').length,
};
---

<BaseLayout
  title="Conference Presentations"
  description="Conference Presentations and meeting abstracts from the SuPER-AI Lab."
>
  <section class="container-page py-10">
    <nav class="flex flex-wrap gap-2 text-xs">
      <a href="/publications/" class="px-3 py-1.5 border border-rule text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">Research Papers ({counts.papers})</a>
      <a href="/publications/preprints/" class="px-3 py-1.5 border border-rule text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">Preprints ({counts.preprints})</a>
      <a href="/publications/conferences/" class="px-3 py-1.5 border border-ink text-ink no-underline">Conferences ({counts.conferences})</a>
    </nav>

    <p class="mt-6 text-sm">
      <a href="/talks/" class="text-accent no-underline">See Talks and Seminars →</a> for invited talks and university seminars.
    </p>

    <PublicationList items={items} />
  </section>
</BaseLayout>
