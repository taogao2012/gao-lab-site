---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import PublicationList from '../../components/PublicationList.astro';
import { site } from '../../config';
import publications from '../../data/publications.json';

const MIN_YEAR = 2014;
const all = publications.items.filter((p: any) => (p.year ?? 0) >= MIN_YEAR);
const papers = all
  .filter((p: any) => p.kind === 'journal')
  .sort((a: any, b: any) => (b.date ?? '').localeCompare(a.date ?? ''));

const totalCitations = papers.reduce((sum: number, p: any) => sum + (p.citations ?? 0), 0);

const articleJsonLd = papers.slice(0, 50).map((p: any) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.title,
  datePublished: p.date,
  author: p.authors.map((a: any) => ({ '@type': 'Person', name: a.name })),
  citation: p.venue,
  identifier: p.doi ? `doi:${p.doi}` : p.id,
  url: p.doi ? `https://doi.org/${p.doi}` : p.id,
}));

const counts = {
  papers: all.filter((p: any) => p.kind === 'journal').length,
  preprints: all.filter((p: any) => p.kind === 'preprint').length,
  conferences: all.filter((p: any) => p.kind === 'conference').length,
};
---

<BaseLayout
  title="Research Papers"
  description={`Peer-reviewed research papers from the SuPER-AI Lab at North Carolina State University — ${counts.papers} works since ${MIN_YEAR}.`}
  jsonLd={articleJsonLd}
>
  <section class="container-page py-10">
    <div class="flex flex-wrap gap-3 items-center text-sm">
      <nav class="flex gap-2 text-xs">
        <a href="/publications/" class="px-3 py-1.5 border border-ink text-ink no-underline">Research Papers ({counts.papers})</a>
        <a href="/publications/preprints/" class="px-3 py-1.5 border border-rule text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">Preprints ({counts.preprints})</a>
        <a href="/publications/conferences/" class="px-3 py-1.5 border border-rule text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">Conferences ({counts.conferences})</a>
      </nav>
      <span class="text-xs text-ink-muted ml-auto">Last refresh: {new Date(publications.$generatedAt).toLocaleDateString()}</span>
    </div>

    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <a href={site.social.scholar} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-ink/30 px-4 py-2 no-underline text-ink hover:border-accent hover:text-accent transition-colors">
        <Icon name="scholar" size={16} /> View on Google Scholar
      </a>
      <a href={site.social.orcid} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-ink/30 px-4 py-2 no-underline text-ink hover:border-accent hover:text-accent transition-colors">
        <Icon name="orcid" size={16} /> ORCID record
      </a>
    </div>

    <PublicationList items={papers} />
  </section>
</BaseLayout>
