---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import publications from '../../data/publications.json';

const all = publications.items;
const items = all
  .filter((p: any) => p.kind === 'patent')
  .sort((a: any, b: any) => (b.date ?? '').localeCompare(a.date ?? ''));

const counts = {
  papers: all.filter((p: any) => p.kind === 'journal').length,
  preprints: all.filter((p: any) => p.kind === 'preprint').length,
  conferences: all.filter((p: any) => p.kind === 'conference').length,
  patents: all.filter((p: any) => p.kind === 'patent').length,
};
---

<BaseLayout
  title="Patents"
  description="Patents and patent applications from the SuPER Lab."
>
  <section class="container-page py-10">
    <nav class="flex flex-wrap gap-2 text-xs">
      <a href="/publications/" class="px-3 py-1.5 border border-rule text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">Research Papers ({counts.papers})</a>
      <a href="/publications/preprints/" class="px-3 py-1.5 border border-rule text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">Preprints ({counts.preprints})</a>
      <a href="/publications/conferences/" class="px-3 py-1.5 border border-rule text-ink-soft no-underline hover:border-accent hover:text-accent transition-colors">Conferences ({counts.conferences})</a>
      <a href="/publications/patents/" class="px-3 py-1.5 border border-ink text-ink no-underline">Patents ({counts.patents})</a>
    </nav>

    {items.length > 0 ? (
      <PublicationList items={items} />
    ) : (
      <p class="mt-10 text-sm text-ink-soft">
        No patents listed yet. Add entries via <code class="font-mono text-xs">src/data/publications.overrides.json</code> → <code class="font-mono text-xs">additions[]</code> with <code class="font-mono text-xs">kind: "patent"</code>.
      </p>
    )}
  </section>
</BaseLayout>
