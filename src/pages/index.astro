---
import BaseLayout from '../layouts/BaseLayout.astro';
import Slideshow from '../components/Slideshow.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { galleryItems } from '../data/gallery';
import { site } from '../config';

const research = (await getCollection('research'))
  .filter((r) => r.data.kind === 'thrust')
  .sort((a, b) => a.data.order - b.data.order);

const highlights = galleryItems
  .filter((i) => i.category === 'highlights')
  .sort((a, b) => (+new Date(b.date ?? 0)) - (+new Date(a.date ?? 0)));

const yearOf = (d?: string) => (d ? new Date(d).getFullYear() : null);
const byYear = new Map<number, typeof highlights>();
const undated: typeof highlights = [] as any;
for (const h of highlights) {
  const y = yearOf(h.date);
  if (y == null) { undated.push(h as any); continue; }
  if (!byYear.has(y)) byYear.set(y, [] as any);
  byYear.get(y)!.push(h as any);
}

// Years newest -> oldest. A year with only one or two items is folded into the
// next (older) year; a year that already has three or more stands on its own.
const sortedYears = [...byYear.keys()].sort((a, b) => b - a);
const groups: { id: string; label: string; items: typeof highlights }[] = [];
let span: number[] = [];
let spanItems: typeof highlights = [] as any;
for (const y of sortedYears) {
  span.push(y);
  spanItems.push(...byYear.get(y)!);
  if (spanItems.length >= 3) {
    const hi = span[0], lo = span[span.length - 1];
    groups.push({ id: `year-${hi}`, label: hi === lo ? `${hi}` : `${lo}–${hi}`, items: spanItems });
    span = []; spanItems = [] as any;
  }
}
if (span.length) {
  const hi = span[0], lo = span[span.length - 1];
  groups.push({ id: `year-${hi}`, label: hi === lo ? `${hi}` : `${lo}–${hi}`, items: spanItems });
}
if (undated.length) groups.push({ id: 'year-undated', label: 'Undated', items: undated });
---

<BaseLayout title={undefined} description={site.description}>
  <section class="container-page pt-5 pb-4">
    <div class="max-w-3xl mx-auto text-center mb-4">
      <p class="font-serif text-2xl md:text-3xl font-semibold text-accent leading-tight">SuPER Lab</p>
      <p class="mt-1 text-sm md:text-base font-bold text-ink-soft">
        <span class="font-bold text-accent">Su</span>stainable
        <span class="font-bold text-accent">P</span>rocessing and
        <span class="font-bold text-accent">E</span>nergy
        <span class="font-bold text-accent">R</span>esilience Lab
      </p>
      <p class="mt-2 font-serif text-lg md:text-xl font-bold leading-snug tracking-tight text-ink-soft">
        Electrochemical Engineering <span class="text-accent">for a sustainable energy future.</span>
      </p>
      <p class="mt-1.5 text-sm text-ink-soft leading-snug" style="text-wrap: balance">
        We design materials, electrolytes, and processes that enable the next generation of batteries, reactors, and separations — for grid-scale energy storage and clean manufacturing.
      </p>
    </div>
    <div class="max-w-2xl mx-auto">
      <Slideshow />
    </div>
  </section>

  <!-- RESEARCH THRUSTS on paper -->
  <section class="bg-paper">
    <div class="container-page py-14">
      <div class="flex items-end justify-between gap-6 mb-8">
        <div>
          <p class="eyebrow text-accent mb-2">SuPER</p>
          <h2 class="font-serif">Three applied thrusts, two fundamental themes.</h2>
        </div>
        <a href="/research/" class="hidden md:inline-flex items-center gap-2 text-sm text-ink-soft no-underline hover:text-accent">
          Full research program <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {research.map((r, i) => (
          <a href={`/research/${r.slug}/`} class="bg-white hover:bg-highlight border-t-4 border-accent p-5 no-underline block group transition-colors">
            <p class="eyebrow text-accent">Thrust {i + 1}</p>
            <h3 class="mt-2 font-serif text-xl text-ink group-hover:text-accent transition-colors">{r.data.title}</h3>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed">{r.data.summary}</p>
            <p class="mt-4 text-sm text-accent inline-flex items-center gap-1 no-underline font-medium">
              Read more <Icon name="arrow-right" size={12} />
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-10 border-t border-rule">
    <h2 class="font-serif text-2xl mb-6 text-center">Highlights</h2>

    <nav aria-label="Years" class="flex flex-wrap justify-center gap-2 mb-10">
      {groups.map((g) => (
        <a href={`#${g.id}`} class="text-xs px-2.5 py-1 border border-rule no-underline text-ink-soft hover:border-accent hover:text-accent transition-colors">
          {g.label} <span class="text-ink-muted">({g.items.length})</span>
        </a>
      ))}
    </nav>

    <div class="space-y-12">
      {groups.map((g) => (
        <section id={g.id} class="scroll-mt-24">
          <h3 class="font-serif text-3xl border-b border-rule pb-3 mb-6 text-center">{g.label}</h3>
          <div class="flex flex-wrap justify-center gap-6 lg:gap-8">
            {g.items.map((item: any) => (
              <figure class="group w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-24px)] max-w-sm">
                <a href={item.href ?? item.src} target="_blank" rel="noopener" class:list={['block overflow-hidden border border-rule no-underline', item.fit === 'contain' ? 'bg-white' : 'bg-paper']}>
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      'w-full aspect-[4/3] transition-transform duration-300 group-hover:scale-[1.02]',
                      item.fit === 'contain' ? 'object-contain p-4' : 'object-cover',
                    ]}
                  />
                </a>
                {(item.caption || item.date) && (
                  <figcaption class="mt-2 flex flex-col items-center gap-1 text-xs text-ink-muted text-center">
                    {item.caption && <span class="text-ink-soft">{item.caption}</span>}
                    {item.date && <span class="font-mono">{item.date}</span>}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
