---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import cv from '../data/cv.json';
import publications from '../data/publications.json';
import newsData from '../data/news.json';

const news = [...newsData.items]
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 3);

const research = (await getCollection('research'))
  .filter((r) => r.data.kind === 'thrust')
  .sort((a, b) => a.data.order - b.data.order);

const selectedPubs = publications.items.filter((p: any) => p.selected).slice(0, 4);
const latestPubs = publications.items.slice(0, 3);
const headlinePubs = selectedPubs.length >= 3 ? selectedPubs : latestPubs;

const latestAward = cv.awards[0];
const totalGrants = cv.grants.externalTotal;
---

<BaseLayout title={undefined} description={site.description}>
  <!-- ANNOUNCEMENT BANNER -->
  <div class="bg-accent text-white">
    <div class="container-page py-3 text-sm font-medium text-center">
      📣 The SuPER-AI Lab is moving to North Carolina State University, Department of Chemical and Biomolecular Engineering, in Fall 2026.
    </div>
  </div>

  <!-- HERO -->
  <section class="container-page pt-16 md:pt-24 pb-16 md:pb-24">
    <div class="grid md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-8">
        <p class="eyebrow mb-5">{site.longName} · {site.pi.institution}</p>
        <h1 class="font-serif text-4xl md:text-6xl leading-[1.05] tracking-tight">
          Electrochemistry for a sustainable energy future.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-ink-soft max-w-2xl leading-relaxed">
          We design materials, electrolytes, and processes that enable the next generation of batteries, redox flow systems, and electrochemical separations — for grid-scale storage and clean manufacturing.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/research/" class="inline-flex items-center gap-2 bg-ink text-white px-5 py-3 no-underline hover:bg-accent transition-colors text-sm font-medium">
            Research thrusts <Icon name="arrow-right" size={16} />
          </a>
          <a href="/publications/" class="inline-flex items-center gap-2 border border-ink/30 text-ink px-5 py-3 no-underline hover:border-accent hover:text-accent transition-colors text-sm font-medium">
            Publications ({publications.count})
          </a>
        </div>
      </div>

      <aside class="md:col-span-4 md:border-l md:border-rule md:pl-8 space-y-6">
        <div>
          <p class="eyebrow mb-2">PI</p>
          <p class="font-serif text-xl text-ink">{cv.person.name}</p>
          <p class="text-sm text-ink-muted mt-1">{cv.person.title}, {cv.person.department}</p>
        </div>
        <div>
          <p class="eyebrow mb-2">Latest recognition</p>
          <p class="text-sm text-ink-soft">
            <span class="text-ink font-medium">{latestAward.year}</span> · {latestAward.name}<br/>
            <span class="text-ink-muted">{latestAward.by}</span>
          </p>
        </div>
        <div>
          <p class="eyebrow mb-2">External research funding</p>
          <p class="font-serif text-2xl text-ink">{totalGrants}</p>
          <p class="text-xs text-ink-muted mt-1">across {cv.grants.external.length} active and selected awards</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- RESEARCH THRUSTS on paper -->
  <section class="bg-paper">
    <div class="container-page py-14">
      <div class="flex items-end justify-between gap-6 mb-8">
        <div>
          <p class="eyebrow text-accent mb-2">SuPER-AI</p>
          <h2 class="font-serif">Three applied thrusts, two fundamental themes.</h2>
        </div>
        <a href="/research/" class="hidden md:inline-flex items-center gap-2 text-sm text-ink-soft no-underline hover:text-accent">
          Full research program <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {research.map((r, i) => (
          <a href={`/research/${r.slug}/`} class="bg-white hover:bg-highlight border-t-4 border-accent p-5 no-underline block group transition-colors">
            <p class="eyebrow text-accent">Thrust {i + 1}</p>
            <h3 class="mt-2 font-serif text-xl text-ink group-hover:text-accent transition-colors">{r.data.title}</h3>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed">{r.data.summary}</p>
            <p class="mt-4 text-sm text-accent inline-flex items-center gap-1 no-underline font-medium">
              Read more <Icon name="arrow-right" size={12} />
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST WORK + NEWS on white -->
  <section class="container-page py-14">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <p class="eyebrow mb-3">Recent publications</p>
        <h2 class="font-serif mb-8">Selected work</h2>
        <ul class="divide-y divide-rule">
          {headlinePubs.map((p: any) => (
            <li class="py-5">
              <a href={p.doi ? `https://doi.org/${p.doi}` : p.id} target="_blank" rel="noopener" class="no-underline group">
                <p class="text-xs text-ink-muted">{p.year} · {p.venue ?? '—'}</p>
                <h3 class="font-serif text-lg text-ink group-hover:text-accent mt-1 transition-colors">{p.title}</h3>
                <p class="text-sm text-ink-soft mt-1 line-clamp-2">
                  {p.authors.slice(0, 6).map((a: any) => a.isPI ? `**${a.name}**` : a.name).join(', ')}
                  {p.authors.length > 6 ? ', et al.' : ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
        <a href="/publications/" class="mt-6 inline-flex items-center gap-2 text-sm text-accent no-underline">
          See all {publications.count} publications <Icon name="arrow-right" size={12} />
        </a>
      </div>

      <aside>
        <p class="eyebrow mb-3">News</p>
        <h2 class="font-serif mb-8">From the lab</h2>
        {news.length === 0 ? (
          <p class="text-sm text-ink-muted">First news entries coming soon. Follow on <a href={site.social.twitter} target="_blank" rel="noopener">X</a> and <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>.</p>
        ) : (
          <ul class="space-y-6">
            {news.map((n) => (
              <li>
                <a href={n.link ?? '/news/'} target={n.link ? '_blank' : undefined} rel={n.link ? 'noopener' : undefined} class="no-underline group">
                  <p class="text-xs text-ink-muted">{new Date(n.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
                  <p class="font-serif text-lg text-ink group-hover:text-accent mt-1 transition-colors">{n.title}</p>
                  {n.summary && <p class="text-sm text-ink-soft mt-1 line-clamp-2">{n.summary}</p>}
                </a>
              </li>
            ))}
          </ul>
        )}
        <a href="/news/" class="mt-6 inline-flex items-center gap-2 text-sm text-accent no-underline">
          All news <Icon name="arrow-right" size={12} />
        </a>
      </aside>
    </div>
  </section>

  <!-- CTA on accent block -->
  <section class="bg-accent text-white">
    <div class="container-page py-14 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="font-serif text-white">Join the lab.</h2>
        <p class="mt-3 text-white/90 max-w-prose">
          We're recruiting motivated PhD students, postdocs, and undergraduates to work on electrochemical materials, batteries, and sustainable processing.
        </p>
      </div>
      <div class="md:text-right">
        <a href="/join-us/" class="inline-flex items-center gap-2 bg-white text-accent px-5 py-3 no-underline hover:bg-paper transition-colors text-sm font-medium">
          Open positions <Icon name="arrow-right" size={16} />
        </a>
        <a href={`mailto:${cv.person.email}`} class="ml-3 inline-flex items-center gap-2 border border-white/40 text-white px-5 py-3 no-underline hover:bg-white/10 transition-colors text-sm font-medium">
          Email the PI
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
