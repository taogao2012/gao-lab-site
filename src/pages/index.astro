---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import cv from '../data/cv.json';
import publications from '../data/publications.json';
import newsData from '../data/news.json';

const news = [...newsData.items]
  .sort((a, b) => +new Date(b.date) - +new Date(a.date))
  .slice(0, 3);

const research = (await getCollection('research'))
  .filter((r) => r.data.kind === 'thrust')
  .sort((a, b) => a.data.order - b.data.order);

const selectedPubs = publications.items.filter((p: any) => p.selected).slice(0, 4);
const latestPubs = publications.items.slice(0, 3);
const headlinePubs = selectedPubs.length >= 3 ? selectedPubs : latestPubs;

const honors = cv.awards.slice(0, 6);
const pubCount = publications.items.length;
---

<BaseLayout title={undefined} description={site.description}>
  <!-- HERO -->
  <section class="container-page pt-16 md:pt-24 pb-16 md:pb-24">
    <div class="grid md:grid-cols-12 gap-10 items-stretch">
      <div class="md:col-span-8">
        <p class="eyebrow text-accent mb-5">{site.longName} · {site.pi.institution}</p>
        <h1 class="font-serif text-4xl md:text-6xl leading-[1.05] tracking-tight text-ink">
          Electrochemical Engineering <span class="text-accent">for a sustainable energy future.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl text-ink-soft max-w-2xl leading-relaxed">
          We design materials, electrolytes, and processes that enable the next generation of batteries, reactors, and separations — for grid-scale energy storage and clean manufacturing.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/research/" class="inline-flex items-center gap-2 bg-accent text-white px-5 py-3 no-underline hover:bg-accent-deep transition-colors text-sm font-medium">
            Research thrusts <Icon name="arrow-right" size={16} />
          </a>
          <a href="/publications/" class="inline-flex items-center gap-2 border border-ink/30 text-ink px-5 py-3 no-underline hover:border-accent hover:text-accent transition-colors text-sm font-medium">
            Publications ({pubCount})
          </a>
        </div>
      </div>

      <aside class="md:col-span-4 md:border-l md:border-rule md:pl-8 space-y-6">
        <div>
          <p class="eyebrow text-accent mb-2">PI</p>
          <a href="/people/pi/" class="font-serif text-xl text-ink no-underline hover:text-accent transition-colors">{cv.person.name}</a>
          <p class="text-sm text-ink-muted mt-1">{cv.person.title}, {cv.person.department}</p>
        </div>
        <div>
          <p class="eyebrow text-accent mb-2">Awards &amp; honors</p>
          <ul class="space-y-2.5">
            {honors.map((a) => (
              <li class="text-sm text-ink-soft leading-snug">
                <span class="text-accent font-semibold">{a.year}</span> · {a.name}
              </li>
            ))}
          </ul>
          <a href="/awards/" class="mt-3 inline-flex items-center gap-1 text-xs text-accent no-underline">
            All awards <Icon name="arrow-right" size={12} />
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- MOTIVATION: paradigm shift -->
  <section class="border-t border-rule">
    <div class="container-page py-8 md:py-10">
      <div class="text-center mb-5 md:mb-6 max-w-3xl mx-auto">
        <p class="eyebrow text-accent mb-2">Motivation</p>
        <h2 class="font-serif text-2xl md:text-3xl text-ink">A paradigm shift in the energy system</h2>
        <p class="mt-2 font-serif text-xl md:text-2xl text-accent">Metals and materials as energy carriers and building blocks</p>
        <p class="mt-3 text-base md:text-lg text-ink-soft leading-relaxed">
          Our world is transitioning from a hydrocarbon-based energy system toward one built on metals and materials. Our research aims to accelerate this transition by conducting cutting-edge applied and fundamental research.
        </p>
      </div>
      <img
        src="/images/research/paradigm-shift-02.png"
        alt="Side-by-side comparison of the 19th–20th century fuel-based energy system (hydrocarbons, pipelines, combustion; well-to-combustion oil schematic; quote 'Fundamentally, the energy transition is a material transition') and the 21st century metal- and material-based energy system (sun and wind, electricity as primary currency, metals and materials for storage and conversion; solar→battery→EV schematic; a table mapping solar cells, batteries, wires, inverters, motors, reactors, and heaters to the metals they require)."
        loading="lazy"
        decoding="async"
        class="block max-w-5xl w-full max-h-[55vh] object-contain mx-auto"
      />
    </div>
  </section>

  <!-- RESEARCH THRUSTS on paper -->
  <section class="bg-paper">
    <div class="container-page py-14">
      <div class="flex items-end justify-between gap-6 mb-8">
        <div>
          <p class="eyebrow text-accent mb-2">SuPER</p>
          <h2 class="font-serif">Three applied thrusts, two fundamental themes.</h2>
        </div>
        <a href="/research/" class="hidden md:inline-flex items-center gap-2 text-sm text-ink-soft no-underline hover:text-accent">
          Full research program <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {research.map((r, i) => (
          <a href={`/research/${r.slug}/`} class="bg-white hover:bg-highlight border-t-4 border-accent p-5 no-underline block group transition-colors">
            <p class="eyebrow text-accent">Thrust {i + 1}</p>
            <h3 class="mt-2 font-serif text-xl text-ink group-hover:text-accent transition-colors">{r.data.title}</h3>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed">{r.data.summary}</p>
            <p class="mt-4 text-sm text-accent inline-flex items-center gap-1 no-underline font-medium">
              Read more <Icon name="arrow-right" size={12} />
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST WORK + NEWS on white -->
  <section class="container-page py-14">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <p class="eyebrow text-accent mb-3">Recent publications</p>
        <h2 class="font-serif mb-8">Selected work</h2>
        <ul class="divide-y divide-rule">
          {headlinePubs.map((p: any) => (
            <li class="py-5">
              <a href={p.doi ? `https://doi.org/${p.doi}` : p.id} target="_blank" rel="noopener" class="no-underline group">
                <p class="text-xs text-ink-muted">{p.year} · {p.venue ?? '—'}</p>
                <h3 class="font-serif text-lg text-ink group-hover:text-accent mt-1 transition-colors">{p.title}</h3>
                <p class="text-sm text-ink-soft mt-1 line-clamp-2">
                  {p.authors.slice(0, 6).map((a: any) => a.isPI ? `**${a.name}**` : a.name).join(', ')}
                  {p.authors.length > 6 ? ', et al.' : ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
        <a href="/publications/" class="mt-6 inline-flex items-center gap-2 text-sm text-accent no-underline">
          See all {pubCount} publications <Icon name="arrow-right" size={12} />
        </a>
      </div>

      <aside>
        <p class="eyebrow text-accent mb-3">News</p>
        <h2 class="font-serif mb-8">From the lab</h2>
        {news.length === 0 ? (
          <p class="text-sm text-ink-muted">First news entries coming soon. Follow on <a href={site.social.twitter} target="_blank" rel="noopener">X</a> and <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>.</p>
        ) : (
          <ul class="space-y-6">
            {news.map((n) => (
              <li>
                <a href={n.link ?? '/news/'} target={n.link ? '_blank' : undefined} rel={n.link ? 'noopener' : undefined} class="no-underline group">
                  <p class="text-xs text-ink-muted">{new Date(n.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
                  <p class="font-serif text-lg text-ink group-hover:text-accent mt-1 transition-colors">{n.title}</p>
                  {n.summary && <p class="text-sm text-ink-soft mt-1 line-clamp-2">{n.summary}</p>}
                </a>
              </li>
            ))}
          </ul>
        )}
        <a href="/news/" class="mt-6 inline-flex items-center gap-2 text-sm text-accent no-underline">
          All news <Icon name="arrow-right" size={12} />
        </a>
      </aside>
    </div>
  </section>

  <!-- CTA on accent block -->
  <section class="bg-accent text-white">
    <div class="container-page py-14 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="font-serif text-white">Join the lab.</h2>
        <p class="mt-3 text-white/90 max-w-prose">
          We're recruiting motivated PhD students, postdocs, and undergraduates to work on electrochemical materials, batteries, and sustainable processing.
        </p>
      </div>
      <div class="md:text-right">
        <a href="/join-us/" class="inline-flex items-center gap-2 bg-white text-accent px-5 py-3 no-underline hover:bg-paper transition-colors text-sm font-medium">
          Open positions <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
