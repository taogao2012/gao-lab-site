---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import cv from '../data/cv.json';
---

<BaseLayout
  title="Awards and Grants"
  description="Honors, fellowships, and externally funded research projects led by the SuPER-AI Lab."
  noindex
>
  <PageHeader
    eyebrow="Recognition"
    title="Awards and Grants"
    description={`${cv.grants.externalTotal} in external funding across ${cv.grants.external.length} active and selected awards.`}
  />

  <section class="container-page py-12 grid lg:grid-cols-3 gap-12">
    <!-- AWARDS -->
    <div class="lg:col-span-1">
      <h2 class="font-serif text-2xl mb-6">Awards</h2>
      <ol class="space-y-5">
        {cv.awards.map((a) => (
          <li class="border-l-2 border-rule pl-4">
            <p class="font-mono text-xs text-ink-muted">{a.year}</p>
            <p class="font-serif text-base text-ink mt-1">{a.name}</p>
            <p class="text-sm text-ink-muted mt-0.5">{a.by}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- GRANTS -->
    <div class="lg:col-span-2">
      <div class="mb-10">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="font-serif text-2xl">External grants</h2>
          <p class="text-sm text-ink-muted">Total: <span class="font-medium text-ink">{cv.grants.externalTotal}</span></p>
        </div>
        <ol class="divide-y divide-rule">
          {cv.grants.external.map((g, i) => (
            <li class="py-5 grid sm:grid-cols-12 gap-3">
              <p class="sm:col-span-1 font-mono text-xs text-ink-muted pt-1">{String(i + 1).padStart(2, '0')}</p>
              <div class="sm:col-span-11">
                <p class="font-serif text-lg text-ink">{g.title}</p>
                <p class="text-sm text-ink-soft mt-1.5">{g.sponsor}</p>
                <p class="text-xs text-ink-muted mt-1">
                  {g.period ?? '—'} · {g.role}
                  {g.share && <> · share <span class="text-ink-soft">{g.share}</span> of {g.total}</>}
                  {!g.share && <> · {g.total}</>}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="font-serif text-2xl">Internal grants</h2>
          <p class="text-sm text-ink-muted">Total: <span class="font-medium text-ink">{cv.grants.internalTotal}</span></p>
        </div>
        <ol class="divide-y divide-rule">
          {cv.grants.internal.map((g, i) => (
            <li class="py-5 grid sm:grid-cols-12 gap-3">
              <p class="sm:col-span-1 font-mono text-xs text-ink-muted pt-1">{String(i + 1).padStart(2, '0')}</p>
              <div class="sm:col-span-11">
                <p class="font-serif text-base text-ink">{g.title}</p>
                <p class="text-sm text-ink-soft mt-1.5">{g.sponsor}</p>
                <p class="text-xs text-ink-muted mt-1">
                  {g.period ?? '—'} · {g.role} · {g.total}
                  {g.share && <> (share {g.share})</>}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
